<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="io.github.libxposed.permission.BIND_XPOSED_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.android.systemui" />
        <package android:name="com.miui.aod" />
    </queries>

    <application
        android:name=".HyperGlowApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".bridge.SpicyLyricBridgeService"
            android:exported="true"
            android:stopWithTask="false" />

        <receiver
            android:name=".diagnostics.DiagnosticCaptureTimeoutReceiver"
            android:exported="false" />

        <service
            android:name=".aod.AodLyricBridgeService"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:stopWithTask="false" />

        <provider
            android:name=".bridge.SpicyLyricBridgeProvider"
            android:authorities="${applicationId}.spicybridge"
            android:exported="true"
            android:grantUriPermissions="true">
            <grant-uri-permission android:pathPrefix="/" />
        </provider>
    </application>
</manifest>
